#!/bin/bash
# shellops — Main entry point for ShellOps Educational Toolkit
# Routes commands to appropriate modules and provides help system

set -euo pipefail

# Get script directory for relative imports
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source common utilities and configuration
source "$SCRIPT_DIR/lib/common.sh" || exit 1
source "$SCRIPT_DIR/lib/config.sh" || exit 1

# ============================================================================
# Configuration
# ============================================================================

readonly SHELLOPS_VERSION="1.0.0"
readonly CONFIG_FILE="${SCRIPT_DIR}/config/shellops.conf"

# ============================================================================
# Help System
# ============================================================================

show_version() {
    echo "ShellOps v${SHELLOPS_VERSION} — Educational Linux System Administration Toolkit"
}

show_main_help() {
    cat << 'EOF'
ShellOps — Educational Linux System Administration Toolkit

USAGE:
    shellops [COMMAND] [OPTIONS]

COMMANDS:
    init                Initialize configuration (run setup wizard)
    
    monitor             Track active users and login activity
      monitor [action]    — users, idle, history, alerts, summary, count
    
    cleanup             Disk cleanup and analysis
      cleanup [action]    — analyze, find-large, duplicates, temp-dirs, clean-temp, recommendations
    
    backup              Backup scheduling and management
      backup [action]     — create, list, rotate, manifest, restore, schedule, test
    
    health              System health monitoring
      health [action]     — report, quick, cpu, memory, disk, network, uptime, updates
    
    help [COMMAND]      Display help for command or topic
    version             Show version information
    
COMMON OPTIONS:
    --dry-run           Preview changes without making them
    --help, -h          Show this help message
    --verbose, -v       Verbose output
    
QUICK START:
    1. Run setup wizard (optional)
        shellops init
    
    2. Check system health
        shellops health
    
    3. Monitor users
        shellops monitor summary
    
    4. Analyze disk space
        shellops cleanup analyze
    
    5. Create backup (preview mode)
        shellops backup test
    
For detailed help on a command:
    shellops help [monitor|cleanup|backup|health]

EOF
}

show_command_help() {
    local command="$1"
    
    case "$command" in
        monitor|user|users)
            cat << 'EOF'
MONITOR — User Activity Monitoring

DESCRIPTION:
    Track active users, login times, idle time, and suspicious activity

USAGE:
    shellops monitor [ACTION]

ACTIONS:
    users        List currently active users
    idle         Show user idle times
    history      Display last logins (default: last 10)
    alerts       Check for suspicious activity (e.g., root logins)
    summary      Full summary (all above)
    count        Get count of active users

EXAMPLES:
    # See active users
    shellops monitor users
    
    # Check idle times
    shellops monitor idle
    
    # View last 20 logins
    shellops monitor history 20
    
    # Get full summary
    shellops monitor summary

CONFIGURATION:
    USER_MONITOR_IDLE_THRESHOLD — Seconds before user marked idle (default: 3600)
    USER_MONITOR_ALERT_ROOT_LOGINS — Alert on root activity (default: true)

EOF
            ;;
        cleanup|disk)
            cat << 'EOF'
CLEANUP — Disk Space Analysis & Cleanup

DESCRIPTION:
    Identify large files, duplicates, and manage temporary directories

USAGE:
    shellops cleanup [ACTION] [TARGET] [OPTIONS]

ACTIONS:
    analyze           Show disk usage summary
    find-large        Find files larger than threshold
    duplicates        Find duplicate files by hash
    temp-dirs         Show temporary directory sizes
    clean-temp        Clean old files from temp dirs
    recommendations   Generate cleanup suggestions
    disk-summary      Show all mounted filesystems

OPTIONS:
    --dry-run         Preview changes without making them (default: true)
    --execute         Actually perform cleanup operations
    --force           Force cleanup without confirmation

EXAMPLES:
    # Show disk usage in current directory
    shellops cleanup analyze
    
    # Find large files (safe, analysis only)
    shellops cleanup find-large /home
    
    # Show cleanup recommendations
    shellops cleanup recommendations /home
    
    # Clean temp directories (preview mode)
    shellops cleanup clean-temp --dry-run
    
    # Actually clean temp directories
    shellops cleanup clean-temp --execute

CONFIGURATION:
    DISK_CLEANUP_SIZE_THRESHOLD — Minimum file size to report (default: 100MB)
    DISK_CLEANUP_DRY_RUN — Default to dry-run mode (default: true)

EOF
            ;;
        backup)
            cat << 'EOF'
BACKUP — Backup Scheduling & Management

DESCRIPTION:
    Create, schedule, and manage tar/gzip backups with automatic rotation

USAGE:
    shellops backup [ACTION] [OPTIONS]

ACTIONS:
    create       Create a new backup immediately
    list         Show all existing backups
    rotate       Remove old backups (keep last N)
    manifest     Generate file listing for backup
    restore      Restore files from backup
    schedule     Add backup to system cron
    test         Create test backup

EXAMPLES:
    # Create a backup now
    shellops backup create
    
    # List existing backups
    shellops backup list
    
    # See what files are in a backup
    shellops backup manifest /path/to/backup.tar.gz
    
    # Restore from a backup (prompts for confirmation)
    shellops backup restore /path/to/backup.tar.gz /restore/location
    
    # Schedule automated backups
    shellops backup schedule
    
    # Test backup system
    shellops backup test

CONFIGURATION:
    BACKUP_DIRS — Space-separated directories to backup
    BACKUP_RETENTION_COUNT — Number of backups to keep (default: 10)
    BACKUP_COMPRESSION — gzip, bzip2, xz, or none (default: gzip)
    BACKUP_SCHEDULE — Cron expression for automatic backups
    BACKUP_ENABLED — Enable automatic backups (default: false)

EOF
            ;;
        health|monitor-system)
            cat << 'EOF'
HEALTH — System Health Monitoring

DESCRIPTION:
    Monitor CPU, memory, disk usage and check system services

USAGE:
    shellops health [ACTION]

ACTIONS:
    report       Generate comprehensive health report
    quick        Quick status summary (CPU|Memory|Disk)
    cpu          Show CPU usage percentage
    memory       Show memory usage percentage
    disk         Show disk usage for root partition
    network      Test network connectivity
    uptime       Show system uptime
    updates      Check available package updates

EXAMPLES:
    # Full health report with alerts
    shellops health report
    
    # Quick status check
    shellops health quick
    
    # Check memory usage
    shellops health memory
    
    # Test network connectivity
    shellops health network

CONFIGURATION:
    HEALTH_CHECK_CPU_THRESHOLD — Alert if CPU > X% (default: 80)
    HEALTH_CHECK_MEMORY_THRESHOLD — Alert if memory > X% (default: 80)
    HEALTH_CHECK_DISK_THRESHOLD — Alert if disk > X% (default: 80)

EOF
            ;;
        init|setup)
            cat << 'EOF'
INIT — Interactive Configuration

DESCRIPTION:
    Run the interactive setup wizard to configure ShellOps

USAGE:
    shellops init

WHAT IT DOES:
    1. Presents a series of questions about your preferences
    2. Configures which features to enable
    3. Sets performance thresholds
    4. Configures backup targets and schedules
    5. Generates config file at: config/shellops.conf

AFTER RUNNING:
    Review your configuration:
        cat config/shellops.conf
    
    Test your setup:
        ./test.sh
    
    Start using ShellOps:
        shellops health
        shellops monitor summary

EOF
            ;;
        *)
            log_error "No help available for: $command"
            echo ""
            show_main_help
            return 1
            ;;
    esac
}

# ============================================================================
# Module Loading & Execution
# ============================================================================

# Load and execute monitor module
execute_monitor() {
    source "$SCRIPT_DIR/lib/user_monitor.sh" || {
        log_error "Failed to load user monitoring module"
        return 1
    }
    user_monitor_main "$@"
}

# Load and execute cleanup module
execute_cleanup() {
    source "$SCRIPT_DIR/lib/disk_cleanup.sh" || {
        log_error "Failed to load disk cleanup module"
        return 1
    }
    disk_cleanup_main "$@"
}

# Load and execute backup module
execute_backup() {
    source "$SCRIPT_DIR/lib/backup_schedule.sh" || {
        log_error "Failed to load backup module"
        return 1
    }
    backup_schedule_main "$@"
}

# Load and execute health module
execute_health() {
    source "$SCRIPT_DIR/lib/health_check.sh" || {
        log_error "Failed to load health check module"
        return 1
    }
    health_check_main "$@"
}

# ============================================================================
# Main Command Routing
# ============================================================================

main() {
    # Handle no arguments
    if [[ $# -eq 0 ]]; then
        show_main_help
        return 0
    fi
    
    local command="$1"
    shift || true
    
    # Initialize configuration
    init_config "$CONFIG_FILE" || {
        log_warn "Could not initialize configuration, using defaults"
    }
    
    # Route to appropriate handler
    case "$command" in
        # Help & Information
        help|--help|-h)
            if [[ $# -gt 0 ]]; then
                show_command_help "$1"
            else
                show_main_help
            fi
            ;;
        
        version|--version|-v)
            show_version
            ;;
        
        # Setup
        init|setup|initialize)
            log_info "Starting setup wizard..."
            bash "$SCRIPT_DIR/setup_wizard.sh"
            ;;
        
        # Feature Commands
        monitor|mon)
            execute_monitor "$@"
            ;;
        
        cleanup|clean|disk)
            execute_cleanup "$@"
            ;;
        
        backup|back|bak)
            execute_backup "$@"
            ;;
        
        health|check|status)
            execute_health "$@"
            ;;
        
        # Unknown
        *)
            log_error "Unknown command: $command"
            echo ""
            show_main_help
            return 1
            ;;
    esac
}

# ============================================================================
# Entry Point
# ============================================================================

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
    exit $?
fi
