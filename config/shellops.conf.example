#!/bin/bash
# config/shellops.conf.example
# Example ShellOps Configuration File
# Generated by setup wizard
# Copy and customize for your system

# ============================================================================
# Feature Enablement
# ============================================================================
# Set to true to enable a feature, false to disable it

FEATURE_USER_MONITOR=true
FEATURE_DISK_CLEANUP=true
FEATURE_BACKUP=true
FEATURE_HEALTH_CHECK=true

# ============================================================================
# User Monitoring Configuration
# ============================================================================

# When to mark a user as idle (seconds)
# Typical ranges:
#   - 600 (10 min) — Very aggressive, learning environments
#   - 1800 (30 min) — Standard, educational labs
#   - 3600 (1 hour) — Common, mixed environments
#   - 7200 (2 hours) — Relaxed, production servers
USER_MONITOR_IDLE_THRESHOLD=3600

# Alert when root logs in (security monitoring)
# Set to true to warn about root activity
USER_MONITOR_ALERT_ROOT_LOGINS=true

# ============================================================================
# Disk Cleanup Configuration
# ============================================================================

# Minimum file size to report as "large" (bytes)
# Examples:
#   1048576         = 1 MB
#   10485760        = 10 MB
#   52428800        = 50 MB
#   104857600       = 100 MB (default)
#   524288000       = 500 MB
#   1073741824      = 1 GB
DISK_CLEANUP_SIZE_THRESHOLD=104857600

# Default to dry-run mode (preview without changes)
# true = Safe, shows what would happen
# false = Actually makes changes (use with caution!)
DISK_CLEANUP_DRY_RUN=true

# ============================================================================
# Backup Configuration
# ============================================================================

# Directories to backup (space-separated paths)
# Examples:
#   BACKUP_DIRS="/home /etc"                    — User + system
#   BACKUP_DIRS="/home /etc /opt"               — User + system + apps
#   BACKUP_DIRS="/root /var/www /opt/myapp"     — Important paths
BACKUP_DIRS="/home /etc"

# Number of backups to keep before deleting old ones
# Default: 10 (keeps 10 recent backups)
# Range: 1-100
BACKUP_RETENTION_COUNT=10

# Compression format (affects size and speed)
# gzip   — Fast, good compression (default)
# bzip2  — Slower, better compression
# xz     — Very slow, best compression
# none   — No compression (fastest, largest files)
BACKUP_COMPRESSION=gzip

# Cron schedule for automatic backups (optional)
# Leave empty "" to disable automatic backups
# Format: "minute hour day month weekday"
# 
# Examples:
#   "0 2 * * *"     — Daily at 2:00 AM
#   "0 2 * * 0"     — Weekly on Sunday 2:00 AM
#   "0 4 1 * *"     — Monthly 1st at 4:00 AM
#   "30 3 * * 1-5"  — Weekdays at 3:30 AM
#   ""               — Disabled (manual backup only)
BACKUP_SCHEDULE=""

# Enable automatic backups (only if BACKUP_SCHEDULE is set)
# true  — Automatic backups enabled
# false — Manual backups only
BACKUP_ENABLED=false

# ============================================================================
# Health Check Configuration
# ============================================================================

# Alert if CPU usage exceeds X percent
# Default: 80 (triggers alert at 80% or higher)
# Range: 1-100
HEALTH_CHECK_CPU_THRESHOLD=80

# Alert if memory usage exceeds X percent
# Default: 80 (triggers alert at 80% or higher)
# Range: 1-100
HEALTH_CHECK_MEMORY_THRESHOLD=80

# Alert if disk usage exceeds X percent (for / filesystem)
# Default: 80 (triggers alert at 80% or higher)
# Range: 1-100
HEALTH_CHECK_DISK_THRESHOLD=80

# ============================================================================
# Logging Configuration
# ============================================================================

# Verbosity level of logs
# ERROR  — Only errors (minimal output)
# WARN   — Errors + warnings
# INFO   — Normal operations (recommended, default)
# DEBUG  — Verbose debugging information
LOG_LEVEL=INFO

# Enable writing logs to file
# true  — Logs written to file
# false — No logging to file
ENABLE_LOGGING=true

# ============================================================================
# Example Configurations for Different Use Cases
# ============================================================================

# --- For Learning/Educational Environment ---
# Uncomment these lines to use educational settings
# FEATURE_USER_MONITOR=true
# FEATURE_DISK_CLEANUP=true
# FEATURE_BACKUP=false
# FEATURE_HEALTH_CHECK=true
# DISK_CLEANUP_SIZE_THRESHOLD=10485760        # Report files >10MB
# DISK_CLEANUP_DRY_RUN=true                   # Always preview
# LOG_LEVEL=DEBUG                             # Verbose output

# --- For Production Server ---
# Uncomment these lines for production environment
# FEATURE_USER_MONITOR=true
# FEATURE_DISK_CLEANUP=true
# FEATURE_BACKUP=true
# FEATURE_HEALTH_CHECK=true
# USER_MONITOR_IDLE_THRESHOLD=1800            # 30 minutes
# USER_MONITOR_ALERT_ROOT_LOGINS=true
# DISK_CLEANUP_SIZE_THRESHOLD=52428800        # 50 MB threshold
# BACKUP_DIRS="/home /etc /opt /var/www"
# BACKUP_RETENTION_COUNT=30
# BACKUP_SCHEDULE="0 2 * * *"                 # Daily, 2 AM
# BACKUP_ENABLED=true
# HEALTH_CHECK_CPU_THRESHOLD=75               # Stricter
# HEALTH_CHECK_MEMORY_THRESHOLD=85
# HEALTH_CHECK_DISK_THRESHOLD=80
# LOG_LEVEL=INFO

# --- For Development Machine ---
# Uncomment these lines for dev environment
# FEATURE_USER_MONITOR=false
# FEATURE_DISK_CLEANUP=true
# FEATURE_BACKUP=false
# FEATURE_HEALTH_CHECK=true
# DISK_CLEANUP_SIZE_THRESHOLD=104857600       # 100 MB (default)
# DISK_CLEANUP_DRY_RUN=true
# HEALTH_CHECK_CPU_THRESHOLD=95               # Relaxed
# HEALTH_CHECK_MEMORY_THRESHOLD=95
# HEALTH_CHECK_DISK_THRESHOLD=90
# LOG_LEVEL=INFO

# ============================================================================
# Tips for Customization
# ============================================================================

# 1. Backup important data frequently:
#    BACKUP_SCHEDULE="0 2 * * *"  # Daily
#    BACKUP_ENABLED=true
#
# 2. For security monitoring:
#    USER_MONITOR_ALERT_ROOT_LOGINS=true
#    LOG_LEVEL=INFO
#
# 3. For disk space management:
#    DISK_CLEANUP_SIZE_THRESHOLD=10485760   # Lower to find more files
#    DISK_CLEANUP_DRY_RUN=true               # Always preview first!
#
# 4. Learning mode:
#    LOG_LEVEL=DEBUG                         # See what's happening
#    DISK_CLEANUP_DRY_RUN=true              # Safe operations
#    Run: ./shellops help [command]          # Learn commands
#
# 5. After customizing:
#    ./test.sh                   # Validate config
#    ./shellops help             # Review commands
#    ./shellops [command] --dry-run  # Preview first

# ============================================================================
# Configuration Notes
# ============================================================================

# * Restart shellops for config changes to take effect
# * Use ./shellops help for command reference
# * Check logs: /var/log/shellops/shellops.log (or ~/.shellops/logs/)
# * Test before production: ./test.sh
# * Dry-run modes are your friend: --dry-run flag

# Generated $(date '+%Y-%m-%d %H:%M:%S')
